{
  "name": "sobe-e-desce",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run web -w client",
    "typecheck": "tsc --noEmit && npm run typecheck -w client",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "build:server": "tsc -p server/tsconfig.build.json",
    "build:web": "npm run build -w client"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@vitest/coverage-v8": "5.0.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
