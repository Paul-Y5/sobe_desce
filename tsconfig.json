{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "rewriteRelativeImportExtensions": true,
    "types": ["node"]
  },
  "include": ["shared/**/*.ts", "server/**/*.ts", "vitest.config.ts", "playwright.config.ts", "e2e/**/*.ts"]
}
